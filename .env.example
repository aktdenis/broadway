# Akash Console API key — get from console.akash.network → Settings → API Keys
AKASH_API_KEY=ac.sk.production.xxxxx

# GitHub Personal Access Token — needs repo + write:packages scopes
# Create at: github.com/settings/tokens/new
GITHUB_TOKEN=ghp_xxxxx

# Any random string — must match AKASH_PREVIEW_WEBHOOK_SECRET on akash-network/website
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=xxxxx

# The ghcr.io image tag built by the broadway-image workflow
# Format: ghcr.io/{your-github-username}/broadway:latest
BROADWAY_IMAGE=ghcr.io/your-username/broadway:latest
